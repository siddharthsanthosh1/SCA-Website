# Copy to .env.local and paste the values from your Firebase web app config.
# Firebase → Project settings → Your apps → SDK setup and configuration.
#
# These are PUBLIC by design — they ship inside every Firebase web app.
# Security comes from firestore.rules, not from hiding these.
#
# Leave them blank to run in local mode: the app works, progress saves to the
# browser only, and a banner says so.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional. Leave blank to fetch the Python runtime from the jsDelivr CDN.
# Set to /pyodide/ only if you self-host it (see README → Self-hosting Python).
VITE_PYODIDE_URL=
